<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dark ocean gradient background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#070E1B"
                android:endColor="#0D2137"
                android:angle="270" />
        </shape>
    </item>

    <!-- Centered aqua glow circle -->
    <item
        android:width="180dp"
        android:height="180dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#1200C2CB" />
        </shape>
    </item>

    <!-- Centered droplet foreground icon -->
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="center">
        <bitmap
            android:src="@mipmap/ic_launcher"
            android:gravity="center" />
    </item>

</layer-list>
